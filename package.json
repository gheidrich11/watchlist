{
  "name": "watchlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:pwa": "node tests/pwa-static-audit.mjs",
    "test:ios": "npx playwright test tests/ios-pwa.spec.ts --project=\"Mobile Safari\"",
    "test:ios:all": "npx playwright test tests/ios-pwa.spec.ts",
    "test:ios:ui": "npx playwright test tests/ios-pwa.spec.ts --ui",
    "audit:pwa": "node scripts/pwa-audit.mjs",
    "test:all": "npm run test && npm run test:pwa && npm run test:ios"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
