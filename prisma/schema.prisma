// Watchlist MVP - local-first SQLite schema
//
// Design decisions baked in:
// - user_id on bookmarks even though there's no auth yet. Default to 1.
//   When auth lands later, it's a session change, not a migration.
// - tmdb_id is the canonical movie identifier. Title/poster are denormalized
//   for display so we don't re-hit TMDB just to render a list.
// - status enum captures the want/watched/dismissed distinction up front.
// - ProviderCache stores the full provider response per movie + region so we
//   keep the flatrate/ads/rent/buy/free distinction. fetchedAt drives TTL.
// - UserService is a real table (not .env) because it costs ~nothing now and
//   removes one rewrite step when adding a settings UI later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(1)
  tmdbId    Int
  title     String
  posterPath String?
  releaseYear Int?
  status    String   @default("want") // "want" | "watched" | "dismissed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, status])
}

model UserService {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(1)
  // TMDB provider IDs are stable integers. Storing the ID, not the name,
  // means a Netflix rebrand doesn't break our matching logic.
  providerId   Int
  providerName String  // denormalized for display
  region    String   @default("US")
  createdAt DateTime @default(now())

  @@unique([userId, providerId, region])
}

model ProviderCache {
  id         Int      @id @default(autoincrement())
  tmdbId     Int
  region     String   @default("US")
  // Full JSON blob from TMDB's /watch/providers endpoint for this region.
  // Keeps flatrate/ads/rent/buy/free intact so the UI can decide later.
  providerData String
  fetchedAt  DateTime @default(now())

  @@unique([tmdbId, region])
  @@index([fetchedAt])
}
